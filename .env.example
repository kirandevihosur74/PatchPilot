# PatchPilot configuration — copy to `.env` and fill what you have.
# Any blank key -> that service degrades to local/offline mode automatically.

# --- Fireworks (generate) ---
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Model ids drift; confirm live with the /models endpoint. Defaults in llm.py.
FIREWORKS_TRIAGE_MODEL=accounts/fireworks/models/gpt-oss-20b
FIREWORKS_CODER_MODEL=accounts/fireworks/models/kimi-k2p7-code

# --- Daytona (isolate) ---
DAYTONA_API_KEY=
# DAYTONA_API_URL=
# DAYTONA_TARGET=

# --- Braintrust (evaluate) ---
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=PatchPilot

# --- GitHub / CodeRabbit (review) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/name

# --- run knobs ---
# PATCHPILOT_TARGET=./target-app
PATCHPILOT_PATCHED_VERSION=6.0.1
PATCHPILOT_MAX_ITERS=3
# Force local sandbox even if DAYTONA_API_KEY is set:
# PATCHPILOT_LOCAL_SANDBOX=1
